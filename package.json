{
  "name": "ticketping-chat-widget-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/widget",
    "apps/playground",
    "spec"
  ],
  "scripts": {
    "dev": "npm run dev -w @ticketping/playground",
    "build": "npm run build -w @ticketping/chat-widget",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm run build && size-limit",
    "spec:vectors": "node spec/reference/generate-vectors.ts",
    "changeset": "changeset"
  },
  "size-limit": [
    {
      "name": "loader",
      "path": "packages/widget/dist/cdn/loader.js",
      "limit": "2 KB",
      "gzip": true
    },
    {
      "name": "main bundle",
      "path": "packages/widget/dist/cdn/*/widget.js",
      "limit": "45 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "size-limit": "^14.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
