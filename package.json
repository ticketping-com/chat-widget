{
  "name": "ticketping-chat-widget-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/widget",
    "apps/playground",
    "spec"
  ],
  "scripts": {
    "dev": "npm run dev -w @ticketping/playground",
    "build": "npm run build -w @ticketping/chat-widget",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "oxlint . && oxfmt --check .",
    "test:e2e": "playwright test",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "npm run build && size-limit",
    "spec:vectors": "node spec/reference/generate-vectors.ts",
    "examples:check": "node examples/token-routes/check.ts",
    "changeset": "changeset",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,svelte}": "oxlint"
  },
  "size-limit": [
    {
      "name": "loader",
      "path": "packages/widget/dist/cdn/loader.js",
      "limit": "2 KB",
      "gzip": true
    },
    {
      "name": "main bundle",
      "path": "packages/widget/dist/cdn/*/widget.js",
      "limit": "45 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
